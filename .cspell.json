{
  "enableFiletypes": [
    "git-commit",
    "github-actions-workflow",
    "julia",
    "jupyter"
  ],
  "flagWords": [
    "analyse",
    "colour",
    "comparision",
    "favour",
    "flavour",
    "hte",
    "optimise",
    "paramater",
    "parmater",
    "transision",
    "transisions"
  ],
  "ignorePaths": [
    "**/.cspell.json",
    "*.ico",
    ".editorconfig",
    ".envrc",
    ".github/dependabot.yml",
    ".gitignore",
    ".pre-commit-config.yaml",
    ".pre-commit-hooks.yaml",
    ".prettierignore",
    ".vscode/*",
    "codecov.yml",
    "docs/conf.py",
    "pyproject.toml"
  ],
  "language": "en-US",
  "useGitignore": true,
  "version": "0.2",
  "ignoreWords": [
    "Colab",
    "automethod",
    "nbformat",
    "poethepoet",
    "prereleased",
    "toctree",
    "venv"
  ],
  "words": ["Colaboratory", "ComPWA", "Deepnote", "nbhooks"]
